ARG RUNTIME_IMAGE=data-quality-pipeline-monitoring-agent:local
FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS test-dependencies
COPY requirements-toolchain.lock requirements-dev.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements-toolchain.lock \
    && pip install --no-cache-dir --require-hashes -r requirements-dev.lock
FROM ${RUNTIME_IMAGE}
USER root
COPY --from=test-dependencies /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY tests ./tests
COPY scripts/backup.py ./scripts/backup.py
COPY scripts/live_ai_evaluation.py ./scripts/live_ai_evaluation.py
COPY pyproject.toml ./
CMD ["python", "-m", "pytest", "-q", "--basetemp=/tmp/dq-tests", "--cov=dqagent", "--cov-fail-under=80"]
